# SlayFit env — copy to .env.local and fill in. NEVER commit real values.
# Neon Postgres connection string (server-side only; never exposed to the browser).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional shared secret guarding POST /api/score. To enable, set BOTH:
#   SCORE_KEY      (server side, in Vercel env)        — what the API checks
#   VITE_SCORE_KEY (build side, same value)            — what the client sends
# They must match. Leave both unset to keep the endpoint open. Note: the client
# value ships in the JS bundle, so it's a soft guard (stops bots, not experts);
# the always-on per-client rate limit is the real protection.
# SCORE_KEY="some-long-random-string"
# VITE_SCORE_KEY="some-long-random-string"

# Optional Discord community feed. When set, each ESCAPE is posted to this
# channel webhook (player, time, share link). Post-only — the on-site
# leaderboard stays in Neon; we never read back from Discord. Server-side only.
# Create it in Discord: Channel → Edit → Integrations → Webhooks → New Webhook.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/YYYY"
